# Optional. Never commit real keys.
# Flight lookup (pick one or both). Without these, the form still works
# with a manual airport + departure time.
AVIATIONSTACK_API_KEY=
AERODATABOX_KEY=

# Optional. Enables live-traffic drive times via /api/drive.
# Restrict the key to the Distance Matrix / Routes API, server-side only.
GOOGLE_MAPS_API_KEY=

# Local server
PORT=3000
